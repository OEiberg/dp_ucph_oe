    "# Find the long-run probabilities used to initialize the promotion process.\n",
    "def stationary_distribution(trans: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Stationary distribution of a finite Markov transition matrix.\"\"\"\n",
